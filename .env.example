# ============================================================
# TUR ETF Portföy Takip Sistemi — Ortam Değişkenleri Örneği
# Bu dosyayı kopyalayıp ".env" olarak kaydedin
# ============================================================

# ----------------------------------------------------------------
# BlackRock API Ayarları
# ----------------------------------------------------------------
BLACKROCK_PORTFOLIO_ID=239689
BLACKROCK_API_BASE=https://www.blackrock.com/varnish-api/blk-one01-product-data/product-data/api/v1/get-fund-document

# ----------------------------------------------------------------
# Google Sheets Ayarları
# ----------------------------------------------------------------
# Google Sheets tablonuzun ID'si (URL'deki /d/ ile /edit arasındaki kısım)
GOOGLE_SHEETS_ID=1tg5OBvX_ohCrxdiz_2JvtQxTPKmE-hNW27C2WGxH7n0

# Service Account credentials dosyasının yolu
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/service_account.json

# ----------------------------------------------------------------
# Analiz Ayarları
# ----------------------------------------------------------------
# Ağırlık değişimi eşiği (pp cinsinden) — bu değerin altındaki küçük 
# değişimler "önemsiz" olarak işaretlenir
WEIGHT_CHANGE_THRESHOLD=0.05

# Backfill için kaç gün geriye gidilsin (ilk çalıştırmada)
BACKFILL_DAYS=90

# Log seviyesi: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Log dosyası dizini
LOG_DIR=logs
